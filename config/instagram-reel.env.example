# Copy outside git (for example ~/.config/kendo-keiko/instagram-reel.env) and chmod 600.
# Never put real tokens in this repository, issue, PR, or generated artifacts.
INSTAGRAM_AUTH_MODE=instagram_login
INSTAGRAM_GRAPH_API_VERSION=v25.0
INSTAGRAM_USER_ID=replace_with_read_only_verified_ig_user_id
INSTAGRAM_USERNAME=replace_with_exact_business_username
INSTAGRAM_ACCESS_TOKEN=replace_with_token_in_local_secret_store

# Required for --publish. The object must be reachable by Meta's servers.
# Use a dedicated existing S3 key prefix; do not change the site's bucket policy.
INSTAGRAM_REEL_VIDEO_BUCKET=replace_with_existing_bucket
INSTAGRAM_REEL_VIDEO_PUBLIC_BASE_URL=https://kendo-keiko.com
INSTAGRAM_REEL_VIDEO_PREFIX=instagram-reels

# Optional: comma-separated exact area names. Empty means all public regions.
INSTAGRAM_REEL_AREAS=
